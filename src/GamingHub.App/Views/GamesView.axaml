<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:models="using:GamingHub.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.GamesView"
             x:DataType="vm:GamesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12">
        <!-- Header / toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Spielebibliothek" Classes="h1" />
                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Width="200" PlaceholderText="Suchen…" Text="{Binding SearchText, Mode=TwoWay}" />
                <Button Content="Bibliothek scannen" Command="{Binding ScanCommand}" Classes="accent" />
                <Button Content="Speichergrößen" Command="{Binding LoadSizesCommand}" />
            </StackPanel>
        </Grid>

        <!-- Drives -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Volumes}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DiskVolume">
                    <Border Classes="card" Width="240" Margin="0,0,12,12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Root}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="8" />
                            <TextBlock FontSize="12" Classes="muted"
                                       Text="{Binding FreeBytes, StringFormat='Frei: {0:N0} B'}" />
                            <TextBlock FontSize="11" Classes="muted">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:N0} B gesamt · {1:N0} B benutzt">
                                        <Binding Path="TotalBytes" />
                                        <Binding Path="UsedBytes" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Width="120" Height="6" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <!-- Games list -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                        <Border Classes="card" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource PanelBrush2}" CornerRadius="6" Padding="7,2">
                                            <TextBlock Text="{Binding SourceName}" FontSize="10" Classes="muted" />
                                        </Border>
                                        <Border Background="#2A3550" CornerRadius="6" Padding="7,2"
                                                IsVisible="{Binding IsRunning}">
                                            <TextBlock Text="● Läuft" FontSize="10" Foreground="#4ADE80" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstallPath}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock FontSize="12"><Run Text="Größe: " Foreground="#8FA0C8"/><Run Text="{Binding SizeDisplay}"/></TextBlock>
                                        <TextBlock FontSize="12"><Run Text="Spielzeit: " Foreground="#8FA0C8"/><Run Text="{Binding PlaytimeDisplay}"/></TextBlock>
                                        <TextBlock FontSize="12"><Run Text="Zuletzt: " Foreground="#8FA0C8"/><Run Text="{Binding LastPlayedDisplay}"/></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Starten" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Classes="accent" />
                                    <Button Content="Stoppen" Command="{Binding StopCommand}" />
                                    <Button Content="Neustart" Command="{Binding RestartCommand}" IsEnabled="{Binding IsRunning}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
