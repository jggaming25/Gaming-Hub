<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.GamesView"
             x:DataType="vm:GamesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">
        <!-- Header / toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Spielebibliothek" Classes="h1" />
                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="680">
                <TextBox Width="130" Margin="0,0,8,0" PlaceholderText="Suchen…" Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox Width="150" Margin="0,0,8,0" ItemsSource="{Binding DriveOptions}"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />
                <Button Margin="0,0,8,0" Content="Scannen" Command="{Binding ScanCommand}" Classes="accent" />
                <Button Margin="0,0,8,0" Content="Vollständiger Scan" Command="{Binding FullRescanCommand}" />
                <Button Margin="0,0,8,0" Content="Größen" Command="{Binding LoadSizesCommand}" />
                <Button Content="Löschen" Command="{Binding ClearScanCommand}" />
            </WrapPanel>
        </Grid>

        <!-- Kategorie-Reiter (ein Reiter pro Programmart) -->
        <Border Grid.Row="1" Classes="card" Padding="8" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding CategoryOptions}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryFilterOption">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Drives -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Volumes}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveItemViewModel">
                    <Border Classes="card" Width="240" Margin="0,0,12,12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Root}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="8" />
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock FontSize="12" Classes="muted" Text="Frei: " VerticalAlignment="Center" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FreeValue" />
                                            <Binding Path="UnitLabel" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="11" Classes="muted">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {2} gesamt · {1} {2} benutzt">
                                        <Binding Path="TotalValue" />
                                        <Binding Path="UsedValue" />
                                        <Binding Path="UnitLabel" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Width="120" Height="6" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <!-- Games list -->
        <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                        <Border Classes="card" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="{DynamicResource PanelBrush2}" CornerRadius="6" Padding="7,2">
                                            <TextBlock Text="{Binding SourceName}" FontSize="10" Classes="muted" />
                                        </Border>
                                        <Border Background="#2A3550" CornerRadius="6" Padding="7,2">
                                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" Classes="muted" />
                                        </Border>
                                        <Border Background="#2A3550" CornerRadius="6" Padding="7,2"
                                                IsVisible="{Binding IsRunning}">
                                            <TextBlock Text="● Läuft" FontSize="10" Foreground="#4ADE80" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstallPath}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock FontSize="12"><Run Text="Größe: " Foreground="#8FA0C8"/><Run Text="{Binding SizeDisplay}"/></TextBlock>
                                        <TextBlock FontSize="12"><Run Text="Spielzeit: " Foreground="#8FA0C8"/><Run Text="{Binding PlaytimeDisplay}"/></TextBlock>
                                        <TextBlock FontSize="12"><Run Text="Zuletzt: " Foreground="#8FA0C8"/><Run Text="{Binding LastPlayedDisplay}"/></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Starten" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Classes="accent" />
                                    <Button Content="Stoppen" Command="{Binding StopCommand}" />
                                    <Button Content="Neustart" Command="{Binding RestartCommand}" IsEnabled="{Binding IsRunning}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
