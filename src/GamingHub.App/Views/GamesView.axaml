<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:models="using:GamingHub.Core.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.GamesView"
             x:DataType="vm:GamesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">
        <!-- Kopfzeile mit Suche, Laufwerken und Aktionen -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Spielebibliothek" Classes="h1" />
                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBox Width="150" Margin="0,0,8,0" PlaceholderText="Suchen…"
                         Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox Width="160" Margin="0,0,8,0" ItemsSource="{Binding DriveOptions}"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />
                <Button Content="Bibliothek scannen" Command="{Binding ScanCommand}"
                        Classes="accent" Margin="0,0,6,0" />
                <Button Content="Vollständig scannen" Command="{Binding FullRescanCommand}"
                        Margin="0,0,6,0" />
                <Button Content="Scan löschen" Command="{Binding ClearScanCommand}" />
            </WrapPanel>
        </Grid>

        <!-- Kategorie-Reiter -->
        <Border Grid.Row="1" Classes="card" Padding="8" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding CategoryOptions}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryFilterOption">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Laufwerke (kompakt) -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Volumes}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveItemViewModel">
                    <Border Classes="card" Width="230" Margin="0,0,10,10" Padding="12">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Root}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" FontSize="11"
                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding UsedPercent, StringFormat={}{0:0}%}"
                                           FontSize="11" Classes="muted" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent}" Height="6" />
                            <TextBlock FontSize="10" Classes="muted">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1} frei von {2} {1}">
                                        <Binding Path="FreeValue" />
                                        <Binding Path="UnitLabel" />
                                        <Binding Path="TotalValue" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding AccessDisplay}" FontSize="10" Foreground="#22D3EE"
                                       TextWrapping="Wrap" IsVisible="{Binding HasAccessInfo}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
            <ProgressBar IsIndeterminate="True" Width="140" Height="5" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <!-- Karten-Grid -->
        <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="336" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                        <Border Classes="game-card" Margin="8" Width="320">
                            <Grid>
                                <!-- Kompakte Karte -->
                                <Border Classes="game-card-collapsed" CornerRadius="12" ClipToBounds="True"
                                        IsVisible="{Binding !IsExpanded}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="12" RowSpacing="8">
                                        <Button Grid.Row="0" Command="{Binding ToggleExpandedCommand}"
                                                Padding="0" Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Cursor="Hand" ToolTip.Tip="Details anzeigen">
                                            <Grid Height="150">
                                                <Border Height="150" CornerRadius="8" ClipToBounds="True"
                                                        Background="#0F1122"
                                                        IsVisible="{Binding HasThumbnail}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Height="150" CornerRadius="8" ClipToBounds="True"
                                                        Background="#0F1122"
                                                        IsVisible="{Binding !HasThumbnail}">
                                                    <TextBlock Text="{Binding Name, Converter={x:Static vm:CommonConverters.FirstChar}}"
                                                               FontSize="44" FontWeight="Bold" Foreground="#3A3F5E"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <Border Background="#80000000" CornerRadius="8"
                                                        IsVisible="{Binding IsRunning}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <Border Width="44" Height="44" CornerRadius="22" Background="#4ADE80">
                                                            <TextBlock Text="▶" FontSize="18" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="Läuft" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                       Foreground="#E5E7EB" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <Border Padding="5,2" CornerRadius="4" Background="#2A3550">
                                                    <TextBlock Text="{Binding SourceName}" FontSize="9" Classes="muted" />
                                                </Border>
                                                <Border Padding="5,2" CornerRadius="4" Background="#2A3550">
                                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="9" Classes="muted" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="💾" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#A855F7"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Grid.Row="3" Text="{Binding PathDisplay}" FontSize="10"
                                                   Classes="muted" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding PathDisplay}"
                                                   IsVisible="{Binding HasPath}" />

                                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <Button Grid.Column="0" Content="Starten" Command="{Binding LaunchCommand}"
                                                    IsEnabled="{Binding CanLaunch}" Classes="game-btn-start"
                                                    Padding="10,7" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" />
                                            <Button Grid.Column="1" Content="Details" Command="{Binding ToggleExpandedCommand}"
                                                    Padding="10,7" />
                                            <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}"
                                                    IsEnabled="{Binding IsRunning}" Classes="game-btn-stop"
                                                    Padding="10,7" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Detailansicht -->
                                <Border Classes="game-card-expanded" CornerRadius="12" ClipToBounds="True"
                                        IsVisible="{Binding IsExpanded}" Margin="0,0,0,8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="8" ClipToBounds="True"
                                                    Background="#0F1122"
                                                    IsVisible="{Binding HasThumbnail}">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="8" ClipToBounds="True"
                                                    Background="#0F1122"
                                                    IsVisible="{Binding !HasThumbnail}">
                                                <TextBlock Text="{Binding Name, Converter={x:Static vm:CommonConverters.FirstChar}}"
                                                           FontSize="32" FontWeight="Bold" Foreground="#3A3F5E"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                                           Foreground="#E5E7EB" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#2A3550" CornerRadius="4" Padding="5,2">
                                                        <TextBlock Text="{Binding SourceName}" FontSize="10" Classes="muted" />
                                                    </Border>
                                                    <Border Background="#2A3550" CornerRadius="4" Padding="5,2">
                                                        <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" Classes="muted" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                                    Background="{Binding IsRunning, Converter={x:Static vm:CommonConverters.BoolToColor}, ConverterParameter=#4ADE80:#F87171}"
                                                    IsVisible="{Binding IsRunning}">
                                                <TextBlock Text="●" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#0F1122" CornerRadius="8" Padding="12"
                                                IsVisible="{Binding HasPath}">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="🚀" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                                               IsVisible="{Binding HasExecutable}" />
                                                    <TextBlock Grid.Column="1" FontSize="11" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding ExecutableDisplay}"
                                                               IsVisible="{Binding HasExecutable}">
                                                        <Run Text="EXE: " FontWeight="SemiBold" /><Run Text="{Binding ExecutableDisplay}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="#A855F7"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasFolder}">
                                                    <TextBlock Grid.Column="0" Text="📁" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" FontSize="10" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding FolderDisplay}">
                                                        <Run Text="Ordner: " /><Run Text="{Binding FolderDisplay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <Border Background="#0F1122" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⏱ Spielzeit" FontSize="10" Classes="muted" />
                                                    <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="15" FontWeight="Bold" Foreground="#4ADE80" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0F1122" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="📅 Zuletzt gespielt" FontSize="10" Classes="muted" />
                                                    <TextBlock Text="{Binding LastPlayedDisplay}" FontSize="13" FontWeight="Bold" Foreground="#FACC15" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0F1122" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="💾 Größe" FontSize="10" Classes="muted" />
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="13" FontWeight="Bold" Foreground="#A855F7" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                            <Button Grid.Column="0" HorizontalAlignment="Left" Padding="12,8"
                                                    Classes="ghost" Command="{Binding ToggleExpandedCommand}">
                                                <TextBlock Text="▲ Einklappen" FontSize="12" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="1" Content="Starten" Command="{Binding LaunchCommand}"
                                                    IsEnabled="{Binding CanLaunch}" Classes="game-btn-start"
                                                    Padding="22,9" HorizontalAlignment="Right" />
                                            <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}"
                                                    IsEnabled="{Binding IsRunning}" Classes="game-btn-stop"
                                                    Padding="22,9" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
