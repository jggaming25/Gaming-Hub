<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:app="using:GamingHub.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Margin="12">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Einstellungen" Classes="h1" />
                <TextBlock Text="{Binding VersionDisplay}" Classes="muted" FontSize="12" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Updates &amp; Extras" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Beim Start wird automatisch nach neuen Versionen gesucht. Ist die automatische Installation aktiv, wird ein Update direkt im Ladebildschirm heruntergeladen; danach erscheint im Fenster ein Hinweis, dass ein Neustart zum Aktivieren nötig ist. Sonst installierst du Updates manuell über die Schaltflächen unten. Manuelle Downloads bekommst du zusätzlich über die Website." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    <CheckBox Content="Beim Start automatisch nach Updates suchen" IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" />
                    <CheckBox Content="Gefundene Updates beim Start automatisch installieren" IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Jetzt nach Updates suchen" Command="{Binding CheckForUpdatesCommand}" Classes="accent" />
                        <Button Content="Update installieren" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateAvailable}" />
                        <Button Content="Zur Website (Download)" Command="{Binding OpenWebsiteCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Start &amp; Hintergrund" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Mit Windows starten: Gaming Hub wird beim Anmelden automatisch gestartet und legt sich versteckt in den System-Tray – die System-Ressourcen-Erfassung läuft dann dauerhaft im Hintergrund. Das Schließen des Fensters minimiert die App in den Tray (sie läuft weiter)." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    <CheckBox Content="Gaming Hub automatisch beim Windows-Start starten (im Hintergrund)" IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />
                    <Border Background="#F871711A" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding ShowAutostartConfirm}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Autostart wirklich deaktivieren?" FontWeight="SemiBold" Foreground="#F87171" />
                            <TextBlock Text="Hinweis: Läuft Gaming Hub nicht im Hintergrund, kann er keine Messwerte aufzeichnen. In dieser Zeit fehlen dann Werte im System-Ressourcen-Verlauf." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Ja, deaktivieren" Command="{Binding ConfirmDisableAutostartCommand}" />
                                <Button Content="Abbrechen" Command="{Binding CancelDisableAutostartCommand}" Classes="accent" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Darstellung" FontWeight="SemiBold" FontSize="16" />
                    <CheckBox Content="Dunkles Design" IsChecked="{Binding DarkTheme, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding ShowAdminSection}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Admin – Funktionen freischalten" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Als Administrator kannst du hier einzelne Funktionen für alle Nicht-Admins deaktivieren (Regler gelten sofort für alle)." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Flags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FlagToggle">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Value, Mode=TwoWay}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AdminStatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Benachrichtigungen" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Desktop-Benachrichtigungen (neue Nachrichten, klingelnde und verpasste Anrufe) erscheinen rechts unten mit dem Gaming-Hub-Logo, auch wenn die App minimiert ist." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    <CheckBox Content="Desktop-Benachrichtigungen anzeigen" IsChecked="{Binding DesktopNotificationsEnabled, Mode=TwoWay}" />
                    <CheckBox Content="Benachrichtigungstöne abspielen (Klingelton bei Anrufen)" IsChecked="{Binding NotificationSoundEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cleanup" FontWeight="SemiBold" FontSize="16" />
                    <CheckBox Content="Gelöschte Dateien in den Papierkorb verschieben (sicher)" IsChecked="{Binding UseRecycleBin, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Neuigkeiten" FontWeight="SemiBold" FontSize="16" />
                    <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="app:ChangelogEntry">
                                <Expander Margin="0,2" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Date}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Classes="muted" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Programm-Log" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Gaming Hub schreibt alle Programmfehler und wichtige Ereignisse in eine Log-Datei. Diese wird bei Bugreports automatisch mitgeschickt und erleichtert die Fehlersuche erheblich." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogPath}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Log öffnen" Command="{Binding OpenLogFileCommand}" FontSize="12" />
                        <Button Content="Ordner öffnen" Command="{Binding OpenLogFolderCommand}" FontSize="12" />
                        <Button Content="Leeren" Command="{Binding ClearLogCommand}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Haftungsausschluss" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                               Text="Gaming Hub wird ohne Gewähr bereitgestellt. Die Nutzung erfolgt auf eigene Gefahr. Wir haften nicht für Schäden an Hard- oder Software oder für Datenverlust, die durch die Nutzung dieses Programms entstehen. Für das Löschen von Dateien bist du selbst verantwortlich." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
