<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.BugReportView"
             x:DataType="vm:BugReportViewModel">

    <ScrollViewer Margin="12">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Bug melden" Classes="h1" />
                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="App-Version:" Classes="muted" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentGradient}" CornerRadius="8" Padding="10,3">
                            <TextBlock Text="{Binding VersionDisplay}" FontWeight="Bold" Foreground="#08101F" />
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Kategorie" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Kurzer Titel" FontSize="12" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="z.B. App stürzt beim Scannen ab" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Schritte zum Reproduzieren" FontSize="12" />
                        <TextBox Text="{Binding Steps, Mode=TwoWay}" AcceptsReturn="True" Height="160" TextWrapping="Wrap"
                                 PlaceholderText="1. App starten&#10;2. …&#10;3. Fehler tritt auf" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Bugreport senden" Command="{Binding SubmitCommand}" Classes="accent" />
                        <Button Content="Leeren" Command="{Binding ClearCommand}" />
                    </StackPanel>

                    <TextBlock Text="Hinweis: Derzeit wird der Report als vorausgefülltes GitHub-Issue geöffnet. Die direkte Cloud-Übermittlung mit Kommentaren und Status folgt mit der Supabase-Anbindung."
                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
