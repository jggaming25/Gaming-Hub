<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:models="using:GamingHub.Core.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.LightingView"
             x:DataType="vm:LightingViewModel">

    <Grid ColumnDefinitions="320,*" Margin="8">
        <!-- Linke Spalte: Geräte & Profile -->
        <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
            <StackPanel Spacing="12">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💡" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RGB Beleuchtung" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="Geräte &amp; Profile" Classes="muted" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="RGB-Geräte werden gesucht…" FontSize="11" Classes="muted"
                           IsVisible="{Binding !HasDevices}" TextWrapping="Wrap" />

                <!-- Geräte -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🖥 Geräte" FontWeight="SemiBold" FontSize="14" />
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RgbDevice">
                                    <Border Classes="card" Margin="0,2" Padding="10" Background="#0B0D1A">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Type, Converter={x:Static vm:CommonConverters.RgbTypeToGlyph}}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Type}" FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                                    Background="{Binding CurrentColor, Converter={x:Static vm:CommonConverters.ColorToBrush}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Profile -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💾 Profile" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="+" Command="{Binding SaveProfileCommand}" Classes="accent" Padding="8,4" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RgbProfile">
                                    <Border Classes="card" Padding="10" Margin="0,4" Background="#0B0D1A">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="Laden" Command="{Binding $parent[vm:LightingViewModel].LoadProfileCommand}" CommandParameter="{Binding }" Classes="ghost" Padding="6,2" FontSize="11" />
                                                <Button Content="🗑" Command="{Binding $parent[vm:LightingViewModel].DeleteProfileCommand}" CommandParameter="{Binding }" Classes="ghost" Padding="6,2" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Rechte Spalte: Geräte-Steuerung -->
        <Border Grid.Column="1" Classes="card" Padding="16">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🎛 Steuerung" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <Border Padding="6,2" CornerRadius="4" Background="#0B0D1A"
                            IsVisible="{Binding !CanControl}">
                        <TextBlock Text="Wähle links ein Gerät aus" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <Border IsVisible="{Binding CanControl}" Classes="card" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding SelectedDevice.Name}" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding SelectedDevice.Type}" Classes="muted" FontSize="11" />

                        <!-- Farbe -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎨 Farbe" FontWeight="SemiBold" FontSize="14" />
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                        Background="{Binding SelectedColor, Converter={x:Static vm:CommonConverters.ColorToBrush}}" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,*,*" Margin="12,0" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="R" FontSize="11" Classes="muted" />
                                        <TextBox Text="{Binding ColorR, Mode=TwoWay}" Width="60" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0">
                                        <TextBlock Text="G" FontSize="11" Classes="muted" />
                                        <TextBox Text="{Binding ColorG, Mode=TwoWay}" Width="60" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="8,0">
                                        <TextBlock Text="B" FontSize="11" Classes="muted" />
                                        <TextBox Text="{Binding ColorB, Mode=TwoWay}" Width="60" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding ColorHex}" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#FF3B3B" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#FF3B3B" ToolTip.Tip="Rot" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#FF8A00" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#FF8A00" ToolTip.Tip="Orange" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#FFD400" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#FFD400" ToolTip.Tip="Gelb" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#3DFF7A" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#3DFF7A" ToolTip.Tip="Grün" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#00E5FF" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#00E5FF" ToolTip.Tip="Cyan" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#3D7BFF" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#3D7BFF" ToolTip.Tip="Blau" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#A855F7" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#A855F7" ToolTip.Tip="Violett" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#FF3DAE" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#FF3DAE" ToolTip.Tip="Pink" />
                                <Button Width="26" Height="26" Padding="0" CornerRadius="13" Background="#FFFFFF" BorderThickness="0" Command="{Binding ApplyPresetCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Weiß" />
                            </StackPanel>
                            <CheckBox Content="Zwei Farben mischen (Verlauf)" IsChecked="{Binding MixEnabled, Mode=TwoWay}" />

                            <StackPanel Spacing="6" IsVisible="{Binding MixEnabled}">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                            Background="{Binding SecondaryColor, Converter={x:Static vm:CommonConverters.ColorToBrush}}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*" Margin="12,0" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="R2" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding SecondaryR, Mode=TwoWay}" Width="60" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0">
                                            <TextBlock Text="G2" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding SecondaryG, Mode=TwoWay}" Width="60" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" Margin="8,0">
                                            <TextBlock Text="B2" FontSize="11" Classes="muted" />
                                            <TextBox Text="{Binding SecondaryB, Mode=TwoWay}" Width="60" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding SecondaryColorHex}" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Mischung" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                                    <Slider Value="{Binding ColorMix, Mode=TwoWay}" Minimum="0" Maximum="100" Width="180" />
                                    <TextBlock Text="{Binding ColorMix}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Width="30" Height="30" CornerRadius="6"
                                            Background="{Binding MixedColor, Converter={x:Static vm:CommonConverters.ColorToBrush}}" />
                                    <TextBlock Text="{Binding MixedColorHex}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <Button Content="Farbe anwenden" Command="{Binding ApplyColorCommand}" Classes="accent" HorizontalAlignment="Left" Padding="16,8" />
                        </StackPanel>

                        <!-- Effekt -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="✨ Effekt" FontWeight="SemiBold" FontSize="14" />
                            <ComboBox ItemsSource="{Binding AvailableEffects}"
                                      SelectedItem="{Binding SelectedEffect, Mode=TwoWay}"
                                      HorizontalAlignment="Left" Width="200" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel>
                                    <TextBlock Text="Geschwindigkeit" FontSize="11" Classes="muted" />
                                    <Slider Value="{Binding EffectSpeed, Mode=TwoWay}" Minimum="1" Maximum="100" Width="200" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding EffectSpeed}" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Effekt anwenden" Command="{Binding ApplyEffectCommand}" Classes="accent" HorizontalAlignment="Left" Padding="16,8" />
                        </StackPanel>

                        <!-- Zonen -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="🎚 Zonen" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding SelectedDevice.Zones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RgbZone">
                                        <Border Classes="card" Padding="10" Margin="0,4" Background="#0B0D1A">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding LedCount, StringFormat='{} {0} LEDs'}" Classes="muted" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Farbe setzen" Command="{Binding $parent[vm:LightingViewModel].ApplyZoneColorCommand}"
                                                        CommandParameter="{Binding Index}" Classes="ghost" Padding="8,4" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Profil erstellen -->
                <Border Classes="card" Padding="12" Background="#0B0D1A">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 Neues Profil speichern" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewProfileName, Mode=TwoWay}" PlaceholderText="Profilname" Width="200" />
                            <Button Content="Speichern" Command="{Binding SaveProfileCommand}" Classes="accent" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
