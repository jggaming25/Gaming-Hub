<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:svc="using:GamingHub.Core.Services"
             xmlns:models="using:GamingHub.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="GamingHub.App.Views.ResourcesView"
             x:DataType="vm:ResourcesViewModel">

    <Grid RowDefinitions="Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="System-Ressourcen" Classes="h1" />
            <TextBlock Text="Live-Auslastung (Task-Manager-artig) und Einschätzung, ob dein PC ein Spiel schafft." Classes="muted" FontSize="12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10" Margin="0,0,4,0">
                <!-- Top cards -->
                <Grid ColumnDefinitions="*,*,*,*" >
                    <Border Classes="card" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="CPU" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CpuCoresDisplay}" FontSize="11" Classes="muted" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsage}" Height="8" />
                            <TextBlock Text="{Binding CpuUsageDisplay}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding CpuName}" FontSize="10" Classes="muted" TextWrapping="Wrap" MaxHeight="30" />
                            <Border Background="#22D3EE33" CornerRadius="4" Height="60" VerticalAlignment="Bottom" Padding="3">
                                <ItemsControl ItemsSource="{Binding CpuHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Width="4" Height="{Binding}" Background="#22D3EE" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Bottom" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="RAM" FontWeight="SemiBold" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding RamUsage}" Height="8" />
                            <TextBlock Text="{Binding RamUsageDisplay}" FontSize="16" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontSize="12" Classes="muted">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1} verwendet">
                                            <Binding Path="RamUsedDisplay" />
                                            <Binding Path="RamTotalDisplay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Border Background="#4ADE8033" CornerRadius="4" Height="60" Padding="3">
                                <ItemsControl ItemsSource="{Binding RamHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Width="4" Height="{Binding}" Background="#4ADE80" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Bottom" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,0,10,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Netzwerk (Wi-Fi / LAN)" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border CornerRadius="3" Background="#38BDF8" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Text="Download" FontSize="10" Classes="muted" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border CornerRadius="3" Background="#FACC15" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Text="Upload" FontSize="10" Classes="muted" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Height="60">
                                <ItemsControl ItemsSource="{Binding NetDownHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Width="3" Height="{Binding}" Background="#38BDF8" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Bottom" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding NetUpHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Width="3" Height="{Binding}" Background="#FACC15" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Top" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Laufzeit &amp; System" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UptimeDisplay}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Windows läuft seit dem letzten Start" FontSize="9" Classes="muted" />
                            <TextBlock FontSize="11">
                                <Run Text="Installiert: " FontWeight="SemiBold" /><Run Text="{Binding SystemInstallDisplay}" />
                            </TextBlock>
                            <TextBlock FontSize="11">
                                <Run Text="Systemlaufzeit: " FontWeight="SemiBold" /><Run Text="{Binding SystemAgeDisplay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding OsDisplay}" FontSize="10" Classes="muted" TextWrapping="Wrap" MaxHeight="28" />
                            <TextBlock FontSize="11">
                                <Run Text="Angemeldet als: " FontWeight="SemiBold" /><Run Text="{Binding CurrentUserDisplay}" />
                            </TextBlock>
                            <TextBlock FontSize="11">
                                <Run Text="GPU-Auslastung: " /><Run Text="{Binding GpuUsageDisplay}" Foreground="#A855F7" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Classes="muted">
                                <Run Text="Datenträger – Lesen: " /><Run Text="{Binding DiskReadDisplay}" /><Run Text=" · Schreiben: " /><Run Text="{Binding DiskWriteDisplay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Detaillierte Systeminformationen + Kopierbutton -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Systeminformationen" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Alle wichtigen Angaben zu CPU, GPU, RAM und Windows auf einen Blick." FontSize="11" Classes="muted" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋 Systeminfo kopieren" Command="{Binding CopySystemInfoCommand}"
                                    Classes="accent" FontSize="12" Padding="12,6" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Grid.Column="0" Background="#0B0D1A" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Prozessor" FontSize="10" Classes="muted" />
                                    <TextBlock Text="{Binding CpuName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CpuCoresDisplay}" FontSize="10" Classes="muted" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B0D1A" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Grafikkarte" FontSize="10" Classes="muted" />
                                    <TextBlock Text="{Binding GpuName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock FontSize="10" Classes="muted">
                                        <Run Text="VRAM: " /><Run Text="{Binding GpuVramDisplay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0B0D1A" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Arbeitsspeicher" FontSize="10" Classes="muted" />
                                    <TextBlock Text="{Binding RamTotalDisplay}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock FontSize="10" Classes="muted">
                                        <Run Text="{Binding RamUsedDisplay}" /><Run Text=" belegt (" /><Run Text="{Binding RamUsageDisplay}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#0B0D1A" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Windows &amp; System" FontSize="10" Classes="muted" />
                                    <TextBlock Text="{Binding OsDisplay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MotherboardDisplay}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock FontSize="10" Classes="muted">
                                        <Run Text="Installiert: " /><Run Text="{Binding SystemInstallDisplay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10" Classes="muted">
                                        <Run Text="Systemlaufzeit: " /><Run Text="{Binding SystemAgeDisplay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="10" Classes="muted">
                                        <Run Text="Gestartet: " /><Run Text="{Binding BootTimeDisplay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding CopyStatusText}" FontSize="10" Foreground="#4ADE80"
                                   IsVisible="{Binding CopyStatusText, Converter={x:Static vm:CommonConverters.NotEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Verlauf (Hintergrund-Aufzeichnung) -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Verlauf – getrennt nach Messwert" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="#22D3EE22" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryRetentionText}" FontSize="10" Classes="muted" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HistoryStatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" />

                        <TextBlock Text="Noch keine Daten aufgezeichnet (alle 5 Minuten)."
                                   FontSize="12" Classes="muted" IsVisible="{Binding !HasHistory}" />

                        <StackPanel Spacing="2" IsVisible="{Binding HasHistory}">
                            <!-- CPU -->
                            <Grid ColumnDefinitions="132,26,*" Height="72">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#22D3EE" VerticalAlignment="Center" />
                                        <TextBlock Text="CPU-Auslastung" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CpuUsageDisplay}" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="4,0">
                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="50" FontSize="9" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="0" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Column="2" ClipToBounds="True" Background="#0C1120">
                                    <Border VerticalAlignment="Top" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Center" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Bottom" Height="1" Background="#18FFFFFF" />
                                    <Grid ColumnDefinitions="*,*,*,*" IsHitTestVisible="False">
                                        <Border Grid.Column="1" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="2" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="3" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Polyline Stretch="Fill"
                                              Points="{Binding CpuSeries, Converter={x:Static vm:CommonConverters.SeriesToPoints}}"
                                              Stroke="#22D3EE" StrokeThickness="2" />

                                </Grid>
                            </Grid>

                            <!-- RAM -->
                            <Grid ColumnDefinitions="132,26,*" Height="72">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#4ADE80" VerticalAlignment="Center" />
                                        <TextBlock Text="RAM-Auslastung" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RamUsageDisplay}" FontSize="11" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="4,0">
                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="50" FontSize="9" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="0" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Column="2" ClipToBounds="True" Background="#0C1120">
                                    <Border VerticalAlignment="Top" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Center" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Bottom" Height="1" Background="#18FFFFFF" />
                                    <Grid ColumnDefinitions="*,*,*,*" IsHitTestVisible="False">
                                        <Border Grid.Column="1" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="2" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="3" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Polyline Stretch="Fill"
                                              Points="{Binding RamSeries, Converter={x:Static vm:CommonConverters.SeriesToPoints}}"
                                              Stroke="#4ADE80" StrokeThickness="2" />

                                </Grid>
                            </Grid>

                            <!-- GPU -->
                            <Grid ColumnDefinitions="132,26,*" Height="72">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#A855F7" VerticalAlignment="Center" />
                                        <TextBlock Text="GPU-Auslastung" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="falls verfügbar" FontSize="10" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="4,0">
                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="50" FontSize="9" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="0" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Column="2" ClipToBounds="True" Background="#0C1120">
                                    <Border VerticalAlignment="Top" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Center" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Bottom" Height="1" Background="#18FFFFFF" />
                                    <Grid ColumnDefinitions="*,*,*,*" IsHitTestVisible="False">
                                        <Border Grid.Column="1" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="2" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="3" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Polyline Stretch="Fill"
                                              Points="{Binding GpuSeries, Converter={x:Static vm:CommonConverters.SeriesToPoints}}"
                                              Stroke="#A855F7" StrokeThickness="2" />

                                </Grid>
                            </Grid>

                            <!-- Prozesse -->
                            <Grid ColumnDefinitions="132,26,*" Height="72">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#FACC15" VerticalAlignment="Center" />
                                        <TextBlock Text="Prozessanzahl" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="auf Höchstwert skaliert" FontSize="10" Classes="muted" />
                                </StackPanel>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="4,0">
                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="50" FontSize="9" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="0" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Column="2" ClipToBounds="True" Background="#0C1120">
                                    <Border VerticalAlignment="Top" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Center" Height="1" Background="#18FFFFFF" />
                                    <Border VerticalAlignment="Bottom" Height="1" Background="#18FFFFFF" />
                                    <Grid ColumnDefinitions="*,*,*,*" IsHitTestVisible="False">
                                        <Border Grid.Column="1" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="2" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                        <Border Grid.Column="3" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Polyline Stretch="Fill"
                                              Points="{Binding ProcSeries, Converter={x:Static vm:CommonConverters.SeriesToPoints}}"
                                              Stroke="#FACC15" StrokeThickness="2" />

                                </Grid>
                            </Grid>
                            <!-- Zeitachse -->
                            <Grid ColumnDefinitions="132,26,*" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="Zeitraum" FontSize="9" Classes="muted" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding HistoryRangeText}" FontSize="9" Classes="muted"
                                           HorizontalAlignment="Stretch" TextAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="132,26,*" Margin="0,1,0,0">
                                <TextBlock Grid.Column="0" Text="Datum" FontSize="9" Classes="muted" VerticalAlignment="Center" />
                                <Grid Grid.Column="2" ColumnDefinitions="*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding HistoryAxisStart}" FontSize="9" Classes="muted" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding HistoryAxisQuarter}" FontSize="9" Classes="muted" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding HistoryAxisMiddle}" FontSize="9" Classes="muted" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding HistoryAxisThreeQuarter}" FontSize="9" Classes="muted" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding HistoryAxisEnd}" FontSize="9" Classes="muted" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Windows-Benutzer & Gruppen (Premium) -->
                <Border Classes="card" Padding="14" IsVisible="{Binding ShowSystemAccounts}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Windows-Benutzer &amp; -Gruppen" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="#A855F722" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Premium" FontSize="10" Foreground="#A855F7" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Lokale Benutzerkonten und Benutzergruppen dieses PCs." FontSize="11" Classes="muted" />
                        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsLoadingAccounts}" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="4">
                                <TextBlock Text="Benutzerkonten" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Keine gefunden." Classes="muted" FontSize="11" IsVisible="{Binding !HasLocalUsers}" />
                                <ItemsControl ItemsSource="{Binding LocalUsers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LocalUserInfo">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                                <TextBlock Text="{Binding FullName}" FontSize="11" Classes="muted" />
                                                <Border IsVisible="{Binding Disabled}" Background="#F8717133" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="deaktiviert" FontSize="9" Foreground="#F87171" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Benutzergruppen" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Keine gefunden." Classes="muted" FontSize="11" IsVisible="{Binding !HasLocalGroups}" />
                                <ItemsControl ItemsSource="{Binding LocalGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LocalGroupInfo">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                                <TextBlock Text="{Binding Description}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Processes + adapters -->
                <Grid ColumnDefinitions="*,*">
                    <Border Classes="card" Grid.Column="0" Margin="0,0,10,0" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Prozesse" FontWeight="SemiBold" />
                                    <Border Background="#22D3EE22" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessCount, StringFormat='{}{0} gesamt'}" FontSize="10" Foreground="#22D3EE" />
                                    </Border>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="140" FontSize="11"
                                          ItemsSource="{Binding ProcessSortOptions}"
                                          SelectedItem="{Binding SelectedProcessSort, Mode=TwoWay}"
                                          ToolTip.Tip="Sortierung der Prozessliste" />
                            </Grid>
                            <Grid ColumnDefinitions="*,68,78,86,30">
                                <TextBlock Grid.Column="0" Text="Prozess" FontSize="10" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="CPU" FontSize="10" Classes="muted" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Arbeitsspeicher" FontSize="10" Classes="muted" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Aktion" FontSize="10" Classes="muted" HorizontalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="#2A3550" />
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ProcessItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProcessRow">
                                            <Grid ColumnDefinitions="*,30" Margin="0,2">
                                                <Button Grid.Column="0"
                                                        Command="{Binding $parent[UserControl].((vm:ResourcesViewModel)DataContext).StopProcessCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#22D3EE10"
                                                        BorderThickness="0"
                                                        CornerRadius="6"
                                                        Padding="6,3"
                                                        HorizontalContentAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip.Tip="Klicken, um den Prozess zu beenden">
                                                    <Grid ColumnDefinitions="*,68,78,92">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                                                            <TextBlock Text="{Binding PinText}" FontSize="9" VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsPinned}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border IsVisible="{Binding IsOurs}" Background="#22D3EE33" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="Gaming Hub" FontSize="9" Foreground="#22D3EE" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding MemText}" FontSize="12" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <Border Grid.Column="3" IsVisible="{Binding ShowConfirmButton}" CornerRadius="4" Padding="6,2"
                                                                Background="#22D3EE22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ConfirmText}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding ConfirmTextColor}" TextAlignment="Center" TextWrapping="Wrap" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Width="26" Height="26" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding $parent[UserControl].((vm:ResourcesViewModel)DataContext).TogglePinProcessCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding PinTooltip}">
                                                    <TextBlock Text="{Binding PinText}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="1" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Netzwerkadapter" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,90,90" IsVisible="{Binding HasNetworkItems}">
                                <TextBlock Grid.Column="0" Text="Adapter" FontSize="10" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="Download" FontSize="10" Classes="muted" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Upload" FontSize="10" Classes="muted" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="1" Background="#2A3550" IsVisible="{Binding HasNetworkItems}" />
                            <ItemsControl ItemsSource="{Binding NetworkItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NetworkRow">
                                        <Grid ColumnDefinitions="*,90,90" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadText}" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding UploadText}" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Keine aktiven Netzwerkadapter gefunden." Classes="muted" FontSize="11" IsVisible="{Binding !HasNetworkItems}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Compatibility checker -->
                <Grid ColumnDefinitions="*,*">
                    <Border Classes="card" Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Kann ich das spielen?" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Spiel auswählen (oder Name eintippen) und prüfen lassen. Die Empfehlung ist eine Schätzung." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            <AutoCompleteBox HorizontalAlignment="Stretch"
                                             ItemsSource="{Binding GameNames}"
                                             Text="{Binding SelectedGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             IsTextCompletionEnabled="True"
                                             PlaceholderText="Spiel wählen oder eingeben…" />
                            <TextBox Text="{Binding SelectedGameVersion, Mode=TwoWay}"
                                     PlaceholderText="Optionale Version, z. B. 2.1 (für präzisere Web-Recherche)" />
                            <Button Content="Einschätzung berechnen" Command="{Binding EvaluateCommand}" Classes="accent" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="1" Padding="14">
                        <Grid>
                            <StackPanel Spacing="8" IsVisible="{Binding HasResult}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Empfehlung:" FontSize="14" VerticalAlignment="Center" />
                                    <Border Background="{Binding ResultAccent}" CornerRadius="8" Padding="12,4">
                                        <TextBlock Text="{Binding ResultPreset}" FontWeight="Bold" Foreground="#08101F" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Classes="muted">
                                        <Run Text="Score " /><Run Text="{Binding ResultScore}" /><Run Text="/100" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Web-Recherche (im Programm)" Command="{Binding ResearchCommand}" FontSize="12" Classes="accent" IsVisible="{Binding WebSearchEnabled}" />
                                    <Button Content="Im Browser öffnen" Command="{Binding OpenWebSearchCommand}" FontSize="12" />
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsResearching}" />

                                <TextBlock Text="Details" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding ResultNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontSize="12" Classes="muted" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding ResultBottlenecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="#FACC15" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding WebSearchEnabled}">
                                    <TextBlock Text="Web-Recherche" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding WebStatus}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WebSummary}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasWebResult}" />
                                    <TextBlock Text="{Binding WebVersionNote}" FontSize="11" Foreground="#22D3EE" TextWrapping="Wrap" IsVisible="{Binding HasWebResult}" />
                                    <ItemsControl ItemsSource="{Binding WebSources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:WebResearchSource">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Classes="muted" TextWrapping="Wrap" MaxLines="3" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding HasNoResult}">
                                <TextBlock Text="Ergebnis erscheint hier nach der Berechnung." Classes="muted" FontSize="12" />
                                <TextBlock Text="Der Web-Recherche-Button öffnet deinen Browser mit Systemanforderungen-Anfragen." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

