<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.CleanupView"
             x:DataType="vm:CleanupViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="Disk Cleanup" Classes="h1" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                    <TextBlock Text="Suchordner" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ScanPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                    <Button Content="Entfernen" FontSize="11" Padding="6,2" Click="RemoveRootClick" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8" Width="220">
                    <Button Content="Ordner hinzufügen…" HorizontalAlignment="Stretch" Click="AddFolderClick" />

                    <TextBlock Text="Laufwerke auswählen" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriveScanOption">
                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Gewählte Laufwerke übernehmen" HorizontalAlignment="Stretch"
                            Command="{Binding AddSelectedDrivesCommand}" FontSize="11" />

                    <CheckBox Content="In Papierkorb (sicher)" IsChecked="{Binding UseRecycleBin, Mode=TwoWay}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="Prüfung starten" Command="{Binding ScanCommand}" Classes="accent" />
                    <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                    <Button Content="Scan löschen" Command="{Binding ClearScanCommand}" />
                    <Button Content="Alle außer Original markieren" Command="{Binding SelectAllGroupsCommand}" />
                    <Button Content="Auswahl aufheben" Command="{Binding DeselectAllGroupsCommand}" />
                    <Button Content="Ausgewählte löschen" Command="{Binding DeleteSelectedCommand}" />
                    <Button Content="Full Auto Clean" Command="{Binding FullAutoCleanCommand}" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,0,0,12">
            <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Gruppen" Classes="muted" FontSize="11" /><TextBlock Text="{Binding GroupsCount}" FontSize="22" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Freigebbar" Classes="muted" FontSize="11" /><TextBlock Text="{Binding WastedDisplay}" FontSize="22" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Status" Classes="muted" FontSize="11" />
                    <TextBlock Text="{Binding ProgressPhase}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScanning}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanPercent}" Width="150" Height="8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanPercent, StringFormat='{}{0} %'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedDisplay}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ElapsedDisplay}" FontSize="12" Classes="muted" IsVisible="{Binding !IsScanning}" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <Expander HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReclaimText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateFileViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,3">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <Border Grid.Column="1" Background="#2A3550" CornerRadius="5" Padding="6,1" Margin="0,0,8,0"
                                                    IsVisible="{Binding IsKeepCandidate}">
                                                <TextBlock Text="Original" FontSize="10" Foreground="#22D3EE" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Directory}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
