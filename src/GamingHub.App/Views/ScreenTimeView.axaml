<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:models="using:GamingHub.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.ScreenTimeView"
             x:DataType="vm:ScreenTimeViewModel">

    <Grid RowDefinitions="Auto,*" Margin="8">
        <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bildschirmzeit" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Nutzung beobachten – Limits und erlaubte Zeiten mit Premium."
                                   Classes="muted" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <CheckBox Content="Erfassung aktiv" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                    <CheckBox Content="Limits durchsetzen" IsChecked="{Binding Enforce, Mode=TwoWay}"
                              IsVisible="{Binding ShowLimitFeatures}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
            <StackPanel Spacing="12">
                <!-- Übersicht -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Heute insgesamt" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding TodayTotalText}" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="{Binding TodayDateText}" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Meistgenutzte App" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding TopAppName}" FontSize="20" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TopAppText}" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Status" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding Enforce, Converter={x:Static vm:CommonConverters.BoolToText}, ConverterParameter=Limits aktiv:Limits aus}"
                                       FontSize="20" FontWeight="Bold"
                                       IsVisible="{Binding ShowLimitFeatures}" />
                            <TextBlock Text="Basisversion" FontSize="20" FontWeight="Bold"
                                       IsVisible="{Binding ShowLimitHint}" />
                            <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding ShowLimitFeatures}" />
                            <TextBlock Text="Nutzung sichtbar – Limits mit Premium."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding ShowLimitHint}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Premium: 4-Wochen-Diagramm -->
                <Border Classes="card" Padding="16" IsVisible="{Binding ShowLimitFeatures}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="📈 PC-Nutzung der letzten 4 Wochen"
                                       FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="{Binding ChartSummaryText}"
                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="132" Background="#0B0D1A" CornerRadius="8" Padding="10,12,10,6">
                            <ItemsControl ItemsSource="{Binding UsageChart}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenTimeChartBar">
                                        <StackPanel Width="24" Spacing="3" VerticalAlignment="Bottom"
                                                    ToolTip.Tip="{Binding ValueText}">
                                            <Border Height="{Binding BarHeight}" Width="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Background="#22D3EE" CornerRadius="3,3,0,0" />
                                            <TextBlock Text="{Binding DateLabel}" FontSize="8"
                                                       Classes="muted" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="Tägliche Gesamtnutzung des angemeldeten Benutzers. Tageslimits werden um 00:00 Uhr zurückgesetzt."
                                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Nutzung + Limits -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="📊 Meistgenutzte Apps (heute)" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Noch keine Nutzung erfasst." Classes="muted" FontSize="12"
                                       IsVisible="{Binding !HasTopApps}" />
                            <ItemsControl ItemsSource="{Binding TopApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenTimeAppRow">
                                        <Border Classes="card" Background="#0B0D1A" Padding="10" Margin="0,3">
                                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding ProcessName}" Classes="muted" FontSize="10" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2" Margin="12,0">
                                                    <TextBlock Text="{Binding TodayText}" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding LimitText}" FontSize="10"
                                                               Foreground="{Binding LimitColor}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding WeekText}" Classes="muted"
                                                           FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Nutzung der letzten 7 Tage" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="16"
                            IsVisible="{Binding ShowLimitFeatures}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⛔ Limits pro App" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="0 = kein Limit. Änderungen werden sofort gespeichert."
                                       Classes="muted" FontSize="11" />

                            <ItemsControl ItemsSource="{Binding Limits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenTimeLimitRow">
                                        <Border Classes="card" Background="#0B0D1A" Padding="10" Margin="0,3">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                    <StackPanel Grid.Column="1" Margin="6,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding UsageText}" Classes="muted" FontSize="10" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="🗑" Padding="8,4"
                                                            Classes="ghost"
                                                            Command="{Binding $parent[UserControl].((vm:ScreenTimeViewModel)DataContext).RemoveLimitCommand}"
                                                            CommandParameter="{Binding }" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="Minuten / Tag" Classes="muted" FontSize="10" />
                                                        <TextBox Text="{Binding DailyMinutes, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="Minuten / Woche" Classes="muted" FontSize="10" />
                                                        <TextBox Text="{Binding WeeklyMinutes, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0" IsEditable="True"
                                          ItemsSource="{Binding Processes}"
                                          Text="{Binding NewLimitProcess, Mode=TwoWay}"
                                          PlaceholderText="App/Prozess wählen…" />
                                <Button Grid.Column="1" Content="Hinzufügen" Classes="accent"
                                        Command="{Binding AddLimitCommand}" />
                                <Button Grid.Column="2" Content="↻" Classes="ghost"
                                        Command="{Binding ReloadProcessesCommand}" ToolTip.Tip="Prozessliste aktualisieren" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="20"
                            IsVisible="{Binding ShowLimitHint}"
                            Background="#141A33" BorderBrush="#22D3EE55" BorderThickness="1">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="🔒 Limits mit Premium" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding LimitHintText}" Classes="muted" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock Text="Die Nutzung insgesamt und pro App bleibt für alle sichtbar."
                                       FontSize="12" Foreground="#22D3EE" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Zeiten + Profile -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding ShowLimitFeatures}">
                    <Border Grid.Column="0" Classes="card" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🕒 Erlaubte Zeiten &amp; Tageslimit" FontWeight="SemiBold" FontSize="15" />
                            <CheckBox Content="Außerhalb der erlaubten Zeiten sperren"
                                      IsChecked="{Binding BlockOutsideSchedule, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="100,86,20,86,76,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="Wochentag" Classes="muted" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="Von" Classes="muted" FontSize="10" />
                                <TextBlock Grid.Column="3" Text="Bis" Classes="muted" FontSize="10" />
                                <TextBlock Grid.Column="4" Text="Limit" Classes="muted" FontSize="10" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Weekdays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenTimeWeekdayRow">
                                        <Grid ColumnDefinitions="100,86,20,86,76,*" ColumnSpacing="6" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding DayLabel}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding AllowedStart, Mode=TwoWay}"
                                                     PlaceholderText="07:00" />
                                            <TextBlock Grid.Column="2" Text="bis" Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding AllowedEnd, Mode=TwoWay}"
                                                     PlaceholderText="22:00" />
                                            <TextBox Grid.Column="4" Text="{Binding TotalLimitMinutes, Mode=TwoWay}"
                                                     ToolTip.Tip="Minuten pro Tag (0 = kein Limit)" />
                                            <TextBlock Grid.Column="5" Text="Min." Classes="muted" FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="0 = kein Tageslimit. Die erlaubten Zeiten und Tageslimits gelten pro Wochentag und werden um 00:00 Uhr zurückgesetzt."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="💾 Profile" FontWeight="SemiBold" FontSize="15" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScreenTimeProfile">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Profil anwenden" Classes="accent" Command="{Binding ApplyProfileCommand}" />
                                <Button Content="Löschen" Classes="ghost" Command="{Binding DeleteProfileCommand}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding NewProfileName, Mode=TwoWay}" PlaceholderText="Neuer Profilname" />
                                <Button Grid.Column="1" Content="Aktuelles speichern" Classes="accent" Command="{Binding SaveProfileCommand}" />
                            </Grid>
                            <TextBlock Text="Speichert die aktuellen Einstellungen (Limit, Zeiten und App-Limits) als neues Profil."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
