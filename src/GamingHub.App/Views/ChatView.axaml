<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid Margin="12">
        <Border Classes="card" MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="42" HorizontalAlignment="Center" />
                <TextBlock Text="Chat &amp; Voice" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" Classes="muted" MaxWidth="440" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
