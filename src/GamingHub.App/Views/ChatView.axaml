<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="GamingHub.App.Views.ChatView"
             x:Name="ChatRoot"
             x:DataType="vm:ChatViewModel">

    <Grid ColumnDefinitions="300,*" Margin="8">

        <!-- Linke Spalte: Kanäle, DM per E-Mail, Freunde -->
        <Border Grid.Column="0" Classes="card" Padding="0" Margin="0,0,8,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Grid.Row="0" Margin="14,14,14,8" Spacing="2">
                    <TextBlock Text="Kommunikation" Classes="h1" FontSize="18" />
                    <TextBlock Text="Allgemein &amp; Direktnachrichten" Classes="muted" FontSize="11" />
                </StackPanel>

                <!-- DM per E-Mail -->
                <StackPanel Grid.Row="1" Margin="14,0,14,8" Spacing="4">
                    <TextBlock Text="Direktnachricht per E-Mail" FontSize="11" Classes="muted" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding DmEmailInput, Mode=TwoWay}" PlaceholderText="name@mail.de" FontSize="12" />
                        <Button Grid.Column="1" Content="Öffnen" Command="{Binding AddDmByEmailCommand}" Margin="6,0,0,0" FontSize="12" />
                    </Grid>
                    <TextBlock Text="{Binding DmEmailStatus}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Targets}"
                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatTargetItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                        Background="{DynamicResource PanelBrush2}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsOnline}" />
                                        <Border Background="#F87171" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding IsBlocked}">
                                            <TextBlock Text="blockiert" FontSize="9" Foreground="#1B0B0B" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChannelId}" FontSize="10" Classes="muted" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#EF4444" CornerRadius="9" MinWidth="18" Height="18"
                                        Padding="5,0" VerticalAlignment="Center" IsVisible="{Binding HasUnread}">
                                    <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Freunde -->
                <Expander Grid.Row="3" Header="Freunde" Margin="10,0,10,6" IsExpanded="False">
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding FriendEmailInput, Mode=TwoWay}" PlaceholderText="E-Mail" FontSize="12" />
                            <Button Grid.Column="1" Content="Add" Command="{Binding AddFriendByEmailCommand}" Margin="6,0,0,0" FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding FriendStatus}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Friends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FriendItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="angefragt" FontSize="9" Classes="muted"
                                                       IsVisible="{Binding IsIncomingRequest}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Annehmen" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                IsVisible="{Binding IsIncomingRequest}"
                                                Command="{ReflectionBinding #ChatRoot.DataContext.AcceptFriendCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="Entf." FontSize="10" Padding="6,2"
                                                Command="{ReflectionBinding #ChatRoot.DataContext.RemoveFriendCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Noch keine Freunde. Füge jemanden per E-Mail hinzu." FontSize="11"
                                   Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoFriends}" />
                    </StackPanel>
                </Expander>

                <StackPanel Grid.Row="4" Margin="14" Spacing="6">
                    <CheckBox Content="Desktop-Benachrichtigungen" FontSize="12"
                              IsChecked="{Binding DesktopNotificationsEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rechte Spalte: Nachrichten -->
        <Border Grid.Column="1" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0" Padding="16,12" BorderBrush="#2A3350" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedTarget.Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="(Direktnachricht)" FontSize="11" Classes="muted" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedTarget.IsDirect}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Blockieren" Command="{Binding BlockSelectedCommand}" FontSize="11" Padding="8,3"
                                    IsVisible="{Binding CanBlockSelected}" />
                            <Button Content="Entsperren" Command="{Binding UnblockSelectedCommand}" FontSize="11" Padding="8,3"
                                    IsVisible="{Binding CanUnblockSelected}" />
                            <Button Content="Anruf" Command="{Binding CallVoiceCommand}" IsVisible="{Binding CanCallVoice}" />
                            <Button Content="Videoanruf" Command="{Binding CallVideoCommand}" Classes="accent"
                                    IsVisible="{Binding CanCallVideo}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Name="MessageScroller" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Noch keine Nachrichten – schreib die erste!" Classes="muted"
                                   IsVisible="{Binding HasNoMessages}" HorizontalAlignment="Center" Margin="0,20" />
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatMessageItem">
                                    <StackPanel HorizontalAlignment="{Binding IsOwn, Converter={x:Static vm:CommonConverters.MessageAlign}}" Margin="0,1">
                                        <Border MaxWidth="540" CornerRadius="10" Padding="10,7"
                                                Background="{Binding IsOwn, Converter={x:Static vm:CommonConverters.MessageBrush}}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="6,3"
                                                        IsVisible="{Binding HasReply}">
                                                    <TextBlock Text="{Binding ReplyPreview}" FontSize="10" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                                </Border>

                                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="13"
                                                           IsVisible="{Binding !IsDeleted}" />

                                                <Border Background="#22000000" CornerRadius="6" Padding="8,5"
                                                        IsVisible="{Binding HasAttachment}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding AttachmentName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding AttachmentSizeText}" FontSize="10" Classes="muted" />
                                                        <Button Content="Öffnen" FontSize="10" Padding="6,2" HorizontalAlignment="Left"
                                                                Command="{ReflectionBinding #ChatRoot.DataContext.OpenAttachmentCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,1,0,0"
                                                    IsVisible="{Binding !IsDeleted}">
                                            <Button Content="Antworten" FontSize="10" Padding="4,1"
                                                    Command="{ReflectionBinding #ChatRoot.DataContext.ReplyCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Löschen" FontSize="10" Padding="4,1"
                                                    IsVisible="{Binding IsOwn}"
                                                    Command="{ReflectionBinding #ChatRoot.DataContext.DeleteMessageCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" IsVisible="{Binding IsLoggedIn}">
                    <!-- Antwort-Banner -->
                    <Border Margin="12,8,12,0" Padding="10,6" Background="{DynamicResource ChatInputBrush}" CornerRadius="8"
                            IsVisible="{Binding IsReplying}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding ReplyPreview}" FontSize="11" Classes="muted"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="X" FontSize="10" Padding="6,2" Command="{Binding CancelReplyCommand}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12">
                        <Button Grid.Column="0" Content="📎" Command="{Binding AttachFileCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanUseFiles}" />
                        <TextBox Grid.Column="1" Text="{Binding MessageInput, Mode=TwoWay}" PlaceholderText="Nachricht schreiben…"
                                 AcceptsReturn="False" MaxHeight="80" TextWrapping="Wrap"
                                 IsEnabled="{Binding ChatEnabled}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Senden" Command="{Binding SendCommand}" Classes="accent" Margin="8,0,0,0"
                                IsEnabled="{Binding ChatEnabled}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsUploading}" />
                </StackPanel>

                <Border Grid.Row="2" Margin="12" IsVisible="{Binding !IsLoggedIn}" Background="{DynamicResource ChatInputBrush}" CornerRadius="8" Padding="14">
                    <TextBlock Text="Melde dich im Tab „Profil“ an, um zu chatten." Classes="muted" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Anruf-Overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#E60B0D1A" IsVisible="{Binding CallActive}">
            <Border Classes="card" MaxWidth="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="16" MinWidth="360">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CallPeerName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CallStateText}" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid IsVisible="{Binding IsVideoCall}" ColumnDefinitions="*,180" Height="340">
                        <Border Grid.Column="0" Background="#0F1122" CornerRadius="10" Margin="0,0,8,0">
                            <Image Source="{Binding RemoteVideo}" Stretch="Uniform" />
                        </Border>
                        <Border Grid.Column="1" Background="#0F1122" CornerRadius="10">
                            <Image Source="{Binding LocalVideo}" Stretch="Uniform" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <StackPanel Spacing="6" IsVisible="{Binding IsIncoming}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Annehmen" Command="{Binding AcceptCallCommand}" Classes="accent" />
                                <Button Content="Ablehnen" Command="{Binding DeclineCallCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Auflegen" Command="{Binding HangupCallCommand}"
                                IsVisible="{Binding !IsIncoming}" />
                    </StackPanel>

                    <TextBlock Text="Sprache/Video laufen direkt zwischen den Geräten (WebRTC). Eine Kamera-/Mikrofon-Freigabe von Windows muss erlaubt sein."
                               FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
