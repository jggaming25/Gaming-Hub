<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamingHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="340"
        x:Class="GamingHub.App.Views.SplashWindow"
        Icon="/Assets/logo.ico"
        Title="Gaming Hub"
        Width="520" Height="340" CanResize="False" ShowInTaskbar="True"
        WindowDecorations="None" TransparencyLevelHint="Transparent"        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Image#Logo">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.03" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.03" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border CornerRadius="18" Background="{StaticResource AppBgGradient}" BorderBrush="{StaticResource AccentGradient}" BorderThickness="1.5">
        <Grid Margin="34">
            <StackPanel VerticalAlignment="Center" Spacing="14" HorizontalAlignment="Center">
                <Image x:Name="Logo" Source="/Assets/logo.png" Width="110" Height="110" RenderTransformOrigin="50%,50%">
                    <Image.RenderTransform>
                        <ScaleTransform />
                    </Image.RenderTransform>
                </Image>
                <TextBlock Text="GAMING HUB" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentGradient}" />
                <TextBlock Text="Von Gamern für Gamer" FontSize="12" Classes="muted" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="300" Height="6" Margin="0,10,0,0" />
                <TextBlock x:Name="StatusText" Text="Initialisiere…" FontSize="12" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="v0.1.0"
                           FontSize="11" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
