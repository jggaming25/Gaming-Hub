<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GamingHub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="GamingHub.App.Views.DriversView"
             x:DataType="vm:DriversViewModel">

    <Grid RowDefinitions="Auto,*" Margin="12">
        <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🧩" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Treiber" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding DriverCountText}" FontSize="11" Classes="muted" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Classes="muted" HorizontalAlignment="Right"
                               TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Treiber neu laden" Command="{Binding RefreshCommand}" FontSize="12" />
                    <Button Content="Nach Updates suchen" Command="{Binding CheckUpdatesCommand}" Classes="accent" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Installierte Treiber -->
            <TabItem Header="Installierte Treiber">
                <Border Classes="card" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="🔎" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}"
                                     PlaceholderText="Nach Gerät, Hersteller, Klasse oder Version filtern…" />
                            <Button Grid.Column="2" Content="Nach Updates suchen" Command="{Binding CheckUpdatesCommand}"
                                    FontSize="12" Margin="8,0,0,0" />
                        </Grid>

                        <ScrollViewer>
                            <StackPanel Spacing="6">
                                <Border Background="#0B0D1A" CornerRadius="6" Padding="10">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1.3*,0.8*">
                                        <TextBlock Grid.Column="0" Text="Gerät" FontSize="10" FontWeight="SemiBold" Classes="muted" />
                                        <TextBlock Grid.Column="1" Text="Klasse" FontSize="10" FontWeight="SemiBold" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="Hersteller" FontSize="10" FontWeight="SemiBold" Classes="muted" />
                                        <TextBlock Grid.Column="3" Text="Version" FontSize="10" FontWeight="SemiBold" Classes="muted" />
                                        <TextBlock Grid.Column="4" Text="Datum" FontSize="10" FontWeight="SemiBold" Classes="muted" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Drivers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DriverRow">
                                            <Border Background="#0E1024" CornerRadius="6" Padding="10" Margin="0,1">
                                                <Grid ColumnDefinitions="2*,1.2*,1.2*,1.3*,0.8*">
                                                    <TextBlock Grid.Column="0" Text="{Binding DeviceName}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeviceName}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DeviceClass}" FontSize="11" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Provider}" FontSize="11" Classes="muted"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="11" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="4" Text="{Binding DriverDate}" FontSize="11" Classes="muted" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Verfügbare Updates -->
            <TabItem Header="Updates &amp; Installation">
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Verfügbare Treiber-Updates (Windows Update)" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Die Installation läuft über den Windows Update Agent. Windows fordert beim Start Administratorrechte (UAC) an."
                                           FontSize="11" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Windows Update öffnen" Command="{Binding OpenWindowsUpdateCommand}"
                                    FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="#FACC1522" BorderBrush="#FACC15" BorderThickness="1" CornerRadius="8" Padding="10"
                                IsVisible="{Binding IsNotAdministrator}">
                            <TextBlock Text="Hinweis: Für die Installation von Treibern sind Administratorrechte erforderlich. Beim Klick auf „Installieren“ erscheint die Windows-UAC-Abfrage."
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Classes="muted" TextWrapping="Wrap" />

                        <Button Content="Nach Updates suchen" Command="{Binding CheckUpdatesCommand}" Classes="accent"
                                HorizontalAlignment="Left" FontSize="12"
                                IsEnabled="{Binding !IsCheckingUpdates}" />

                        <ItemsControl ItemsSource="{Binding Updates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriverUpdateRow">
                                    <Border Background="#0B0D1A" BorderBrush="#2A3350" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock FontSize="10" Classes="muted">
                                                        <Run Text="Klasse: " /><Run Text="{Binding DriverClass}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Classes="muted">
                                                        <Run Text="Hersteller: " /><Run Text="{Binding Provider}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Classes="muted">
                                                        <Run Text="Version: " /><Run Text="{Binding Version}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Classes="muted">
                                                        <Run Text="Datum: " /><Run Text="{Binding DriverDate}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Classes="muted">
                                                        <Run Text="Größe: " /><Run Text="{Binding SizeText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{Binding StatusColor}"
                                                           IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Installieren"
                                                    Command="{Binding $parent[UserControl].((vm:DriversViewModel)DataContext).InstallUpdateCommand}"
                                                    CommandParameter="{Binding }"
                                                    Classes="accent" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    IsEnabled="{Binding !IsInstalling}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
