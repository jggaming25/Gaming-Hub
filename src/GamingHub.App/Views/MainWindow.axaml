<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamingHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="GamingHub.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Gaming Hub"
        Width="1220" Height="780" MinWidth="980" MinHeight="640"
        Background="{DynamicResource AppBgGradient}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="260,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Border.BorderThickness>0,0,1,0</Border.BorderThickness>
            <Border.BorderBrush>#22FFFFFF</Border.BorderBrush>
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,20" Spacing="13">
                    <Border CornerRadius="10" Padding="0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="40" Height="40" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding AppName}" FontSize="17" FontWeight="Bold" LetterSpacing="0.3" />
                        <TextBlock Text="{Binding Tagline}" FontSize="10.5" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Classes="nav"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="12,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Opacity="{Binding IsLocked, Converter={x:Static vm:CommonConverters.LockedOpacity}}">
                                <Border Grid.Column="0" CornerRadius="6" Width="30" Height="30" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Classes="navglyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" Classes="navlabel"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Classes="navglyph" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLocked}"
                                           ToolTip.Tip="Nur mit Premium nutzbar" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="14,8" Spacing="8">
                    <Border Padding="16,12" CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Gaming Hub" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionDisplay}" FontSize="11" Classes="muted" />

                            <Button Command="{Binding RestartNowCommand}"
                                    IsVisible="{Binding ShowRestartBanner}"
                                    Classes="accent"
                                    Padding="10,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip.Tip="Klicken, um die installierte neue Version zu aktivieren">
                                <TextBlock Text="{Binding RestartBannerText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>

                            <Button Command="{Binding InstallUpdateCommand}"
                                    IsVisible="{Binding ShowUpdateBanner}"
                                    Classes="accent"
                                    Padding="10,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip.Tip="Klicken, um das Update direkt zu installieren">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⬆" FontSize="12" />
                                    <TextBlock Text="{Binding UpdateBannerText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ProgressBar IsVisible="{Binding ShowUpdateInstalling}" IsIndeterminate="True" Height="4" />
                            <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding IsInstallingUpdate}"
                                       FontSize="11" Classes="muted" TextWrapping="Wrap" />

                            <!-- Offline-Hinweis -->
                            <Border IsVisible="{Binding ShowOfflineHint}"
                                    Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                                    Background="#F8717122" BorderBrush="#F87171" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="📡" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Keine Internetverbindung – Web-Recherche &amp; Online-Features deaktiviert."
                                                   TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <Button Content="🔄 Verbindung prüfen" Command="{Binding InternetCheckerViewModel.RunTestCommand}"
                                            Classes="ghost" Padding="8,4" HorizontalAlignment="Left" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <Border Grid.Row="0" Margin="8" Classes="transition-root" x:Name="ContentHost">
                <Grid>
                    <ContentControl Content="{Binding SelectedView}"
                                    IsEnabled="{Binding !IsSelectedPremiumLocked}" />

                    <Border IsVisible="{Binding IsSelectedPremiumLocked}"
                            CornerRadius="12" Background="#E60B0D1A"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="520" Spacing="14" Margin="32">
                            <Border Width="76" Height="76" CornerRadius="38"
                                    HorizontalAlignment="Center"
                                    Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding PremiumLockTitle}" FontSize="21" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PremiumLockText}" FontSize="13.5" Classes="muted"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" />
                            <Button Content="Premium im Profil freischalten"
                                    Command="{Binding OpenPremiumCommand}"
                                    Classes="accent" Padding="20,11"
                                    HorizontalAlignment="Center" Margin="0,6,0,0" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BottomBarBrush}" Padding="16,7">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Haftungsausschluss: Nutzung auf eigene Gefahr – keine Haftung für Schäden an Hard- oder Software."
                               FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding VersionDisplay}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Update-Popup: „Update installiert – Neustart erforderlich“ -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding ShowRestartPopup}"
              Background="#99070A16" ZIndex="50">
            <Border Width="440" Padding="26,22" CornerRadius="16"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentGradient}" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding RestartPopupTitle}" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentGradient}" />
                    <TextBlock Text="{Binding RestartPopupText}" FontSize="12.5" Classes="muted"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                        <Button Grid.Column="0" Content="Später" Margin="0,0,6,0" Padding="10,8"
                                Command="{Binding RestartLaterCommand}" Background="Transparent" BorderBrush="#335482" />
                        <Button Grid.Column="1" Content="Jetzt neu starten" Margin="6,0,0,0" Padding="10,8"
                                Classes="accent" Command="{Binding RestartNowCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

