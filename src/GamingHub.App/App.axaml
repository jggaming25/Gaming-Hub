<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamingHub.App.App"
             xmlns:local="using:GamingHub.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppBgColor">#0B0D1A</Color>
                    <Color x:Key="SidebarColor">#12142A</Color>
                    <Color x:Key="PanelColor">#171A34</Color>
                    <Color x:Key="PanelColor2">#1E2142</Color>
                    <Color x:Key="BottomBarColor">#0F1122</Color>
                    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
                    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
                    <SolidColorBrush x:Key="PanelBrush2" Color="{StaticResource PanelColor2}" />
                    <SolidColorBrush x:Key="BottomBarBrush" Color="{StaticResource BottomBarColor}" />
                    <LinearGradientBrush x:Key="AppBgGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0B0D1A" Offset="0" />
                        <GradientStop Color="#141033" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ChatInputBrush" Color="#1B1F3A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppBgColor">#EEF1FA</Color>
                    <Color x:Key="SidebarColor">#E1E6F6</Color>
                    <Color x:Key="PanelColor">#FFFFFF</Color>
                    <Color x:Key="PanelColor2">#E5EAF7</Color>
                    <Color x:Key="BottomBarColor">#DFE4F4</Color>
                    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
                    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
                    <SolidColorBrush x:Key="PanelBrush2" Color="{StaticResource PanelColor2}" />
                    <SolidColorBrush x:Key="BottomBarBrush" Color="{StaticResource BottomBarColor}" />
                    <LinearGradientBrush x:Key="AppBgGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#EEF1FA" Offset="0" />
                        <GradientStop Color="#DCE2F5" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ChatInputBrush" Color="#F1F4FB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#A855F7" Offset="1" />
            </LinearGradientBrush>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="#08101F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.transition-root">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Moderne Navigationsleiste -->
        <Style Selector="TextBlock.navglyph">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.navlabel">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navglyph">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navlabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Application.Styles>
</Application>