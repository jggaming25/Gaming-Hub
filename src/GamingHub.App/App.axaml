<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamingHub.App.App"
             xmlns:local="using:GamingHub.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="AppBgColor">#0B0D1A</Color>
        <Color x:Key="SidebarColor">#12142A</Color>
        <Color x:Key="PanelColor">#171A34</Color>
        <Color x:Key="PanelColor2">#1E2142</Color>
        <Color x:Key="AccentColor">#22D3EE</Color>
        <Color x:Key="Accent2Color">#A855F7</Color>
        <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="PanelBrush2" Color="{StaticResource PanelColor2}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#22D3EE" Offset="0" />
            <GradientStop Color="#A855F7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AppBgGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0B0D1A" Offset="0" />
            <GradientStop Color="#141033" Offset="1" />
        </LinearGradientBrush>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="Foreground" Value="#08101F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
